{
  "name": "pharmacily",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "pharmacily-web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=pharmacily-web",
    "dev:api": "cd pharmacily-api && go run ./cmd/api",
    "build:web": "npm run build --workspace=pharmacily-web",
    "build:api": "cd pharmacily-api && go build -o bin/api ./cmd/api",
    "lint:web": "npm run lint --workspace=pharmacily-web",
    "lint:api": "cd pharmacily-api && golangci-lint run ./...",
    "test:web": "npm run test --workspace=pharmacily-web",
    "test:api": "cd pharmacily-api && go test ./...",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "generate:api": "cd pharmacily-api && sqlc generate",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  },
  "dependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "lightningcss": "^1.33.0"
  }
}

# Environment
PHARMACILY_ENVIRONMENT=development

# Server
PHARMACILY_SERVER_HOST=0.0.0.0
PHARMACILY_SERVER_PORT=8080

# Database (Supabase local)
PHARMACILY_DATABASE_HOST=127.0.0.1
PHARMACILY_DATABASE_PORT=54322
PHARMACILY_DATABASE_USER=postgres
PHARMACILY_DATABASE_PASSWORD=postgres
PHARMACILY_DATABASE_NAME=postgres

# Supabase
PHARMACILY_SUPABASE_URL=http://127.0.0.1:54321
PHARMACILY_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
PHARMACILY_SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SUPABASE_SERVICE_ROLE_KEY
PHARMACILY_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Worker
PHARMACILY_WORKER_SYNC_CRON_SCHEDULE=0 0 2 * * *
PHARMACILY_WORKER_RETRY_BASE_DELAY=30s
PHARMACILY_WORKER_MAX_RETRIES=5

# Adapter
PHARMACILY_ADAPTER_DEFAULT_RATE_LIMIT=60
PHARMACILY_ADAPTER_REQUEST_TIMEOUT=30s